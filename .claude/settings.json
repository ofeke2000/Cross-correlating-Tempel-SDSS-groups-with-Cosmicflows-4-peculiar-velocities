{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git stash list*)",
      "Bash(ls*)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(du *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(.venv/bin/python -c *)",
      "Bash(pip list*)",
      "Bash(pip show*)",
      "Bash(pip freeze*)",
      "Bash(pip3 list*)",
      "Bash(pip3 show*)",
      "Bash(pip3 freeze*)",
      "Bash(.venv/bin/pip list*)",
      "Bash(.venv/bin/pip show*)",
      "Bash(.venv/bin/pip freeze*)",
      "Bash(command -v *)",
      "Bash(cp -r * /home/ofeke2000/.claude/skills/*)",
      "Edit(~/.claude/skills/**)"
    ],
    "ask": [
      "Bash(rm *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit.py\"",
            "timeout": 330,
            "statusMessage": "Post-edit checks (sign gate, rule 5)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_stale_notebooks.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
